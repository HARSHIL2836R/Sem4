   "source": [
    "def g(n,w):\n",
    "    return np.random.random(n).sum()*np.sqrt(w) - n/2\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 38,
   "metadata": {},
   "outputs": [],
   "source": [
    "y = []\n",
    "N = 10000\n",
    "for i in range(N):\n",
    "    y.append(g(36,3))"
   ]
